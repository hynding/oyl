APP_NAME=oyl
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com

# DreamHost: MySQL created in the panel. Local/e2e use sqlite (see scripts/).
DB_CONNECTION=mysql
DB_HOST=mysql.example.com
DB_PORT=3306
DB_DATABASE=oyl
DB_USERNAME=oyl
DB_PASSWORD=change-me

# Sanctum tokens do not expire by default; bound them in production (minutes).
SANCTUM_TOKEN_EXPIRATION=43200
