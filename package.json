{
  "name": "oyl",
  "description": "Organize Your Life",
  "version": "1.0.0",
  "author": "Steve Hynding",
  "scripts": {
    "all-of": "pnpm --filter @oyl/all-of-oyl",
    "strapi-app": "pnpm --filter @oyl/strapi-oyl-app",
    "stencil": "pnpm --filter @oyl/stencil-oyl",
    "ui": "pnpm --filter @oyl/ui-oyl",
    "e2e": "pnpm --filter @oyl/e2e-oyl e2e",
    "ocari": "pnpm --filter @oyl/ocari-oyl ocari",
    "php-app": "pnpm --filter @oyl/camis-php-oyl",
    "deploy:dreamhost": "bash scripts/deploy-dreamhost.sh",
    "dev": "node scripts/dev.mjs",
    "dev:fresh": "node scripts/dev.mjs --fresh",
    "vanilla": "pnpm --filter @oyl/vanilla-oyl",
    "test": "pnpm --filter './packages/*' --filter './apps/*' --if-present test",
    "lint": "pnpm --filter './packages/*' --filter './apps/*' --if-present lint",
    "typecheck": "pnpm --filter './packages/*' --filter './apps/*' --if-present typecheck"
  },
  "dependencies": {
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.6.1"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.9",
      "postcss": "^8.5.15",
      "uuid": "^11.1.1",
      "shell-quote": "^1.11.0",
      "@hono/node-server@1": "^1.19.18",
      "hono@4": "^4.13.16",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "follow-redirects@1": "^1.16.2",
      "js-yaml@4": "^4.3.2",
      "postcss-selector-parser@7": "^7.1.6",
      "qs@6": "^6.16.1",
      "source-map-js@1": "^1.2.2",
      "undici@6": "^6.29.1",
      "zod@4": "^4.6.6"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "farmhash",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "core-js-pure"
    ],
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "arm64"
      ],
      "libc": [
        "current",
        "musl"
      ]
    }
  }
}
